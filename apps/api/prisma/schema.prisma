// SegInfo Study — persistência no PostgreSQL 16 (banco dedicado seginfo_study).
// Guarda o ESTADO DO USUÁRIO. Trilhas/Tópicos/Labs são conteúdo estático no código.
// Chave de usuário = e-mail do Cloudflare Access (header Cf-Access-Authenticated-User-Email).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a URL de conexão NÃO fica mais aqui.
//  - CLI/migrations: apps/api/prisma.config.ts
//  - Runtime: driver adapter (@prisma/adapter-pg) em src/db.ts
datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  criadoEm  DateTime @default(now())

  progresso    Progresso[]
  sessoes      Sessao[]
  metas        Meta[]
  posts        Post[]
  arsenal      ArsenalItem[]
  biblioteca   BiblioItem[]
  cofre        CofreBlob?
  cofre2fa     Cofre2fa?
  cofreSessoes CofreSessao[]
  cofreEventos CofreEvento[]
  ataques      AtaqueEvento[]
  pericias     Pericia[]
  artefatosAtaque ArtefatoAtaque[]
  armazenamento ArmazenamentoConta?
  backups      BackupRegistro[]
  memorias     Memoria[]
  linkedinPosts LinkedinPost[]
  diario       DiarioEntrada[]
  linkedinEstrategia LinkedinEstrategia?
  linkedinProjetos LinkedinProjeto[]
  linkedinIdeias   LinkedinIdeia[]
  linkedinConta    LinkedinConta?
  agentes      Agente[]
}

// Biblioteca permanente, independente da retenção do Radar e do reset dos alvos.
model ArtefatoAtaque {
  id String @id @default(cuid())
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  chave String
  tipo String
  nome String
  conteudo String @default("")
  sha256 String?
  formato String @default("texto")
  resumo String @default("")
  categoria String @default("outro")
  notas String @default("")
  tags String[] @default([])
  favorito Boolean @default(false)
  amostraBase64 String?
  ocorrencias ArtefatoOcorrencia[]
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  @@unique([usuarioId, chave])
  @@index([usuarioId, tipo, criadoEm])
}

model ArtefatoOcorrencia {
  id String @id @default(cuid())
  artefatoId String
  artefato ArtefatoAtaque @relation(fields: [artefatoId], references: [id], onDelete: Cascade)
  chave String
  alvo String?
  origem String
  referencia String
  caminho String?
  ip String?
  sessao String?
  quando DateTime
  contexto Json @default("{}")
  @@unique([artefatoId, chave])
  @@index([artefatoId, quando])
  @@index([alvo, quando])
}

// Progresso + anotações por tópico (tópico é estático no código)
model Progresso {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  topicoId     String
  status       String   @default("a_estudar") // a_estudar | estudando | concluido
  anotacoes    String   @default("")
  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, topicoId])
  @@index([usuarioId])
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  data      String
  trilhaId  String?
  topicoId  String?
  labId     String?
  minutos   Int
  nota      String   @default("")
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

model Meta {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  trilhaId  String?
  prazo     String
  concluida Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

model Post {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  gancho    String   @default("")
  corpo     String   @default("")
  direcaoVisual String @default("")
  textoAlternativo String @default("")
  roteiroSlides String @default("")
  topicoId  String?
  publicado Boolean  @default(false) // legado: espelha status = publicado
  criadoEm  DateTime @default(now())
  // ----- pipeline do LinkedIn (rascunho -> aprovado -> agendado -> publicado) -----
  status         String    @default("rascunho") // rascunho | aprovado | agendado | publicando | publicado | falhou
  formato        String    @default("texto")    // texto | imagem | carrossel | video | artigo | enquete
  projetoId      String?   // LinkedinProjeto.id (sem FK: apagar o projeto só solta o vínculo)
  ideiaId        String?   // LinkedinIdeia.id que originou o rascunho
  agendadoPara   DateTime? // instante em UTC
  canal          String    @default("lembrete") // lembrete (publica à mão) | api (servidor publica)
  tentativas     Int       @default(0)
  ultimoErro     String    @default("")
  linkedinPostId String?   // LinkedinPost.id criado quando o rascunho foi publicado
  aprovadoEm     DateTime?
  publicadoEm    DateTime?
  atualizadoEm   DateTime  @default(now()) @updatedAt
  versoes        PostVersao[]

  @@index([usuarioId])
  @@index([status, agendadoPara])
}

// Histórico do texto de um rascunho. Refinar com a IA cria uma versão nova em vez de
// sobrescrever, para comparar e voltar atrás.
model PostVersao {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuarioId String
  numero    Int
  gancho    String
  corpo     String
  origem    String   @default("manual") // manual | ia:gerar | ia:<ação> | restaurar:<n>
  criadoEm  DateTime @default(now())

  @@unique([postId, numero])
  @@index([usuarioId])
}

model ArsenalItem {
  id          String   @id @default(cuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo        String   // prompt | skill | agente
  nome        String
  slug        String   @default("")
  dominio     String   @default("geral")
  resumo      String   @default("")
  conteudo    String   @default("")
  quandoUsar  String   @default("")
  requisitos  String[] @default([])
  tags        String[] @default([])
  artefatos   Json     @default("[]")
  favorito    Boolean  @default(false)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([usuarioId])
}

model BiblioItem {
  id            String   @id @default(cuid())
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  url           String
  titulo        String   @default("")
  dominio       String   @default("")
  textoOriginal String   @default("")
  resumo        String   @default("")
  palavrasChave String[] @default([])
  categoria     String   @default("geral")
  tags          String[] @default([])
  estado        String   @default("para_ler")
  favorito      Boolean  @default(false)
  anotacoes     String   @default("")
  topicoId      String?
  fonteResumo   String   @default("local")
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([usuarioId])
  @@index([usuarioId, categoria])
}

// Blob cifrado do cofre (AES-GCM). O servidor nunca vê nada em claro.
model CofreBlob {
  usuarioId  String   @id
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  versao     Int      @default(1)
  salt       String
  iv         String
  ciphertext String
  autoLockMin Int     @default(5)
  atualizadoEm DateTime @updatedAt
}

// Segundo fator (TOTP) do Cofre. `segredo` é cifrado com STORAGE_TOKEN_KEY (AES-256-GCM).
// Códigos de recuperação guardados só como SHA-256. `ultimoPasso` impede reusar um código.
model Cofre2fa {
  usuarioId          String    @id
  usuario            Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  segredo            String
  ativo              Boolean   @default(false)
  ultimoPasso        Int       @default(0)
  falhas             Int       @default(0)
  bloqueadoAte       DateTime?
  codigosRecuperacao String[]  @default([])
  ativadoEm          DateTime?
  atualizadoEm       DateTime  @updatedAt
}

// Sessão curta aberta por um código válido; o token só existe no navegador, aqui fica o hash.
model CofreSessao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// Trilha de auditoria do Cofre: aberturas, falhas, bloqueios, leituras e gravações.
model CofreEvento {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String
  detalhe   String   @default("")
  ip        String?
  agente    String?
  criadoEm  DateTime @default(now())

  @@index([usuarioId, criadoEm])
}

// Laudo de um alvo real do honeypot, gerado na VM do Wazuh antes de cada reset (POST /api/ingest/pericia).
// `dados` guarda o laudo validado (PericiaInSchema); `resumo` traz as contagens para a lista.
model Pericia {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  alvo         String
  vmid         Int
  sistema      String   // linux | windows
  sensor       String?
  janelaInicio DateTime
  janelaFim    DateTime
  resumo       Json     @default("{}")
  dados        Json     @default("{}")
  criadoEm     DateTime @default(now())

  @@unique([usuarioId, alvo, janelaFim])
  @@index([usuarioId, janelaFim])
}

// Radar de Ataques: eventos de tentativa de invasão (FortiGate, Windows 4625/4740, honeypot).
// Nunca guarda senha tentada. `dedupKey` torna a ingestão idempotente (reenvio do coletor).
model AtaqueEvento {
  id             String   @id @default(cuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  fonte          String   // fortigate | windows | cowrie | opencanary | dionaea | heralding | isca | outro
  ocorridoEm     DateTime
  ipOrigem       String?  // nulo só em lockout (evento 4740 não traz IP)
  paisOrigem     String?
  portaDestino   Int?
  protocolo      String?
  servico        String?
  acao           String   // login_falha | login_ok | lockout | scan | bloqueio | conexao | comando | download | reflexao | outro
  usuarioTentado String?
  senhaTentada   String?  // opcional e sensível: só honeypot e só com RADAR_GUARDAR_SENHAS=true
  alvo           String?
  detalhes       Json     @default("{}")
  dedupKey       String
  escopo         String   @default("internet") // internet | interno (rede privada ou sem IP); ver src/radarEscopo.ts
  ambiente       String   @default("nao_classificado")
  criadoEm       DateTime @default(now())

  @@unique([usuarioId, dedupKey])
  @@index([usuarioId, ocorridoEm])
  @@index([usuarioId, escopo, ocorridoEm])
  @@index([usuarioId, ambiente, ocorridoEm])
  @@index([usuarioId, ipOrigem])
  @@index([usuarioId, servico])
}

// Armazenamento externo (OneDrive pessoal). O refresh token é cifrado (AES-256-GCM) com
// STORAGE_TOKEN_KEY antes de ir para o banco; nunca é exposto à API de leitura.
model ArmazenamentoConta {
  usuarioId           String   @id
  usuario             Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  provedor            String   @default("onedrive")
  contaNome           String?
  refreshTokenCifrado String
  conectadoEm         DateTime @default(now())
  ultimoBackupEm      DateTime?
  ultimoErro          String?
}

// Histórico de backups enviados. `sha256` é do arquivo CIFRADO, para conferir integridade.
model BackupRegistro {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nomeArquivo  String
  tamanhoBytes Int
  sha256       String
  status       String   // ok | erro
  erro         String?
  itemId       String?
  criadoEm     DateTime @default(now())

  @@index([usuarioId, criadoEm])
}

// Segundo Cérebro: notas ("memórias") do usuário. Exclusão é AGENDADA (excluirEm): fica na
// lixeira por 7 dias e pode ser resgatada. `escopo = corporativo` nunca vai para o backup externo.
model Memoria {
  id           String    @id @default(cuid())
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo       String
  conteudo     String    @default("")
  tags         String[]  @default([])
  origem       String    @default("manual") // manual | url | cofre
  urlOrigem    String?
  escopo       String    @default("pessoal") // pessoal | corporativo
  excluirEm    DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([usuarioId, atualizadoEm])
  @@index([usuarioId, excluirEm])
}

// LinkedIn: posts publicados oficialmente. `urlNormalizada` (sem query string, minúsculas)
// impede registrar o mesmo post duas vezes. `analise` é o JSON gerado pela IA (Claude);
// `memoriaId` aponta para a nota criada no Segundo Cérebro.
model LinkedinPost {
  id             String   @id @default(cuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  url            String
  urlNormalizada String
  publicadoEm    String   // YYYY-MM-DD
  texto          String
  formato        String   @default("texto") // texto | imagem | carrossel | video | artigo | enquete
  metricas       Json     @default("{}")
  origem         String   @default("manual") // manual | importacao | api
  analise        Json?
  memoriaId      String?
  projetoId      String?  // LinkedinProjeto.id
  urn            String?  // urn:li:share:... quando publicado pela API
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@unique([usuarioId, urlNormalizada])
  @@index([usuarioId, publicadoEm])
}

// Marcos do diário de construção criados pela tela. Os marcos escritos durante o
// desenvolvimento ficam no código (packages/shared/src/diarioProjeto.ts).
model DiarioEntrada {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  data      String   // YYYY-MM-DD
  titulo    String
  descricao String
  categoria String   // funcionalidade | seguranca | infra | decisao | aprendizado | plano
  tags      String[] @default([])
  projetoId String?  // LinkedinProjeto.id
  criadoEm  DateTime @default(now())

  @@index([usuarioId, data])
}

// Posicionamento no LinkedIn (objetivo, público, voz e pilares) usado pela IA.
model LinkedinEstrategia {
  usuarioId    String   @id
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  objetivo     String
  publico      String
  voz          String
  pilares      String[]
  atualizadoEm DateTime @updatedAt
}

// Projeto (ou série) de conteúdo: agrupa ideias, rascunhos, posts publicados e marcos do diário
// em torno de um assunto (ex.: "Honeypot exposto", "Construindo a SegInfo").
model LinkedinProjeto {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome         String
  descricao    String   @default("")
  objetivo     String   @default("")
  pilar        String?
  status       String   @default("ativo") // ativo | pausado | concluido
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([usuarioId, status])
}

// Backlog de ideias de post. Nascem à mão, da análise de um post publicado, de um lab,
// de um marco do diário, do Radar ou do planejador semanal.
model LinkedinIdeia {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo       String
  briefing     String   @default("")
  pilar        String?
  projetoId    String?
  formato      String?
  origem       String   @default("manual") // manual | analise | lab | marco | radar | planejador
  origemRef    String?  // id do post, lab ou marco de origem
  status       String   @default("nova")   // nova | em_rascunho | descartada
  sugeridaPara String?  // YYYY-MM-DD (planejador)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // repetir a análise de um post não duplica as ideias dele
  @@unique([usuarioId, origem, origemRef, titulo])
  @@index([usuarioId, status])
}

// Conexão com a API do LinkedIn (OAuth do app "Share on LinkedIn"). O token fica cifrado
// com STORAGE_TOKEN_KEY (AES-256-GCM) e nunca sai do servidor nem entra em backup.
model LinkedinConta {
  usuarioId           String    @id
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  personUrn           String    // urn:li:person:<id>
  nome                String    @default("")
  accessTokenCifrado  String
  refreshTokenCifrado String?
  expiraEm            DateTime
  escopos             String    @default("")
  ultimoErro          String?
  conectadoEm         DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt
}

// Agents: projeto de um agente de IA (8 pilares), guardado em `config` (JSON validado pelo
// AgenteConfigSchema do shared). A execução fica em AgenteExecucao (apps/api/src/agenteRuntime.ts).
model Agente {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome         String
  resumo       String   @default("")
  status       String   @default("rascunho") // rascunho | teste | ativo | arquivado
  config       Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  avaliacoes   AgenteAvaliacao[]
  execucoes    AgenteExecucao[]

  @@index([usuarioId, atualizadoEm])
}

// Uma execução do agente no playground: um pedido, o laço modelo → ferramenta → modelo
// e a resposta final. `passos` é a trilha de auditoria; `mensagens` é a conversa completa
// no formato da API, guardada para continuar o chat (e, depois, retomar após aprovação).
model AgenteExecucao {
  id            String   @id @default(cuid())
  usuarioId     String
  agenteId      String
  agente        Agente   @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  status        String   @default("rodando") // rodando | aguardando_aprovacao | concluida | limite | recusada | erro
  entrada       String
  resposta      String   @default("")
  erro          String   @default("")
  modelo        String
  passos        Json     @default("[]")
  mensagens     Json     @default("[]")
  // Preenchido só enquanto a execução espera aprovação: as ações pedidas e os resultados já prontos do mesmo turno.
  pendencia     Json?
  tokensEntrada Int      @default(0)
  tokensSaida   Int      @default(0)
  duracaoMs     Int      @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([agenteId, criadoEm])
  @@index([usuarioId, status])
}

// Cada linha é um caso de teste executado e registrado (pilar 8: testes e avaliações).
model AgenteAvaliacao {
  id         String   @id @default(cuid())
  usuarioId  String
  agenteId   String
  agente     Agente   @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  caso       String
  criterio   String   @default("")
  resultado  String   // ok | parcial | falha
  latenciaMs Int?
  observacao String   @default("")
  criadoEm   DateTime @default(now())

  @@index([agenteId, criadoEm])
  @@index([usuarioId])
}
