# Copie para .env na VM do sensor e proteja: chmod 600 .env  (NÃO comite o .env)

# Endpoint de ingestão (HTTPS). É o domínio público da SegInfo, protegido por Access Service Auth.
INGEST_URL=https://estudo.criecom.ia.br/api/ingest

# Service Token do Cloudflare Access (Zero Trust > Access controls > Service credentials)
CF_ACCESS_CLIENT_ID=TROCAR.access
CF_ACCESS_CLIENT_SECRET=TROCAR

# Mesmo valor do INGEST_TOKEN configurado no Coolify (openssl rand -hex 32)
INGEST_TOKEN=TROCAR

# Nome deste sensor (aparece como `alvo` nos eventos do honeypot)
SENSOR_NAME=sensor-01

# IP de origem do FortiGate para o listener de syslog. Vazio = listener DESLIGADO.
# Aceita vários separados por vírgula.
SYSLOG_ALLOW=
