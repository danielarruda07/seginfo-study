# Copiar para /etc/seginfo-forwarder.env (root:root, modo 600). NUNCA versionar o arquivo real.
INGEST_URL=https://SEU-DOMINIO/api/ingest
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
INGEST_TOKEN=
# testes internos que nao devem ir para o Radar (ex.: o proprio honeypot e o PC de administracao)
IGNORAR_IPS=
INCLUIR_WINDOWS=true
WINDOWS_NIVEL_MIN=6
DESDE_INICIO=true
