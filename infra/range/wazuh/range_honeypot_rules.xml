<!-- Regras do honeypot do range (Cowrie e Dionaea). IDs 100200-100229. -->
<group name="honeypot,cowrie,">
  <rule id="100200" level="3">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie: $(eventid) de $(src_ip)</description>
  </rule>
  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>Cowrie: login falho $(username) / $(password) de $(src_ip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>
  <rule id="100202" level="8">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie: login aceito $(username) / $(password) de $(src_ip)</description>
    <mitre><id>T1078</id></mitre>
    <group>authentication_success,</group>
  </rule>
  <rule id="100203" level="10">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie: comando executado por $(src_ip): $(input)</description>
    <mitre><id>T1059</id></mitre>
  </rule>
  <rule id="100204" level="12">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie.session.file_download$|^cowrie.session.file_upload$</field>
    <description>Cowrie: transferencia de arquivo por $(src_ip): $(url) $(shasum)</description>
    <mitre><id>T1105</id></mitre>
  </rule>
  <rule id="100205" level="10" frequency="20" timeframe="120">
    <if_matched_sid>100201</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: forca bruta (20 logins falhos em 2 min) de $(src_ip)</description>
    <mitre><id>T1110.001</id></mitre>
  </rule>
</group>

<group name="honeypot,dionaea,">
  <rule id="100220" level="3">
    <decoded_as>json</decoded_as>
    <field name="connection.protocol">\.+</field>
    <description>Dionaea: conexao $(connection.protocol) porta $(dst_port) de $(src_ip)</description>
  </rule>
  <rule id="100221" level="6">
    <if_sid>100220</if_sid>
    <field name="credentials.username">\.+</field>
    <description>Dionaea: credenciais tentadas em $(connection.protocol) por $(src_ip): $(credentials.username) / $(credentials.password)</description>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100222" level="12">
    <if_sid>100220</if_sid>
    <field name="downloads">\.+</field>
    <description>Dionaea: payload/malware enviado por $(src_ip) via $(connection.protocol)</description>
    <mitre><id>T1105</id></mitre>
  </rule>
</group>

<!-- Heralding: VNC, PostgreSQL, SMTP, POP3, IMAP (sensor/wazuh-forwarder/forwarder.py de_heralding). -->
<group name="honeypot,heralding,">
  <rule id="100223" level="3">
    <decoded_as>json</decoded_as>
    <field name="source_ip">\.+</field>
    <field name="protocol">\.+</field>
    <description>Heralding: sessao $(protocol) porta $(destination_port) de $(source_ip)</description>
  </rule>
  <rule id="100224" level="6">
    <if_sid>100223</if_sid>
    <field name="num_auth_attempts">[1-9]</field>
    <description>Heralding: credenciais tentadas em $(protocol) por $(source_ip) ($(num_auth_attempts) tentativas)</description>
    <mitre><id>T1110</id></mitre>
  </rule>
</group>

<!-- Iscas próprias: Redis, Elasticsearch, API do Docker (sensor/wazuh-forwarder/forwarder.py
     de_isca). Elas só registram e respondem o mínimo plausível; nada é executado de verdade. -->
<group name="honeypot,isca,">
  <rule id="100225" level="3">
    <decoded_as>json</decoded_as>
    <field name="isca_servico">\.+</field>
    <field name="src_ip">\.+</field>
    <description>Isca $(isca_servico): conexao de $(src_ip)</description>
  </rule>
  <rule id="100226" level="6">
    <if_sid>100225</if_sid>
    <field name="senha">\.+</field>
    <description>Isca $(isca_servico): credenciais tentadas por $(src_ip): $(usuario) / $(senha)</description>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100227" level="10">
    <if_sid>100225</if_sid>
    <field name="acao">^container_create$|^container_exec$</field>
    <description>Isca Docker: $(acao) tentado por $(src_ip) (nada foi executado de verdade)</description>
    <mitre><id>T1610</id></mitre>
  </rule>
  <rule id="100228" level="8">
    <if_sid>100225</if_sid>
    <field name="acao">^image_pull$</field>
    <description>Isca Docker: tentativa de baixar imagem por $(src_ip) (nada foi baixado de verdade)</description>
    <mitre><id>T1204</id></mitre>
  </rule>
</group>

<!-- Windows exposto (VM 822) e vitima do range: logon falho vira forca bruta; RDP aceito vira alerta alto -->
<group name="windows,honeypot,">
  <rule id="100240" level="6">
    <if_sid>60122</if_sid>
    <description>Windows: logon falho de $(win.eventdata.targetUserName) a partir de $(win.eventdata.ipAddress)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failed,</group>
  </rule>
  <rule id="100241" level="12">
    <if_sid>60106</if_sid>
    <field name="win.eventdata.logonType">^10$</field>
    <description>Windows: logon RDP ACEITO de $(win.eventdata.targetUserName) a partir de $(win.eventdata.ipAddress)</description>
    <mitre><id>T1078</id><id>T1021.001</id></mitre>
    <group>authentication_success,</group>
  </rule>
</group>
