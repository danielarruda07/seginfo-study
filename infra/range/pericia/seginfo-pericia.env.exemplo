# /etc/seginfo-pericia.env (modo 600). O token Proxmox e o envio ao app vem dos envs do reset e do forwarder.
# vmid:sistema:sensor  (sensor = nome do alvo nos eventos do Radar, para cruzar com quem entrou na janela)
PERICIA_ALVOS=VMID_LINUX:linux:NOME_DO_SENSOR_SSH,VMID_WINDOWS:windows:NOME_DO_AGENTE_WINDOWS
# PERICIA_REGRA_SAIDA=100260
# PERICIA_AMOSTRA_MAX_MB=8
# DRY_RUN=true   # gera o laudo em /var/lib/seginfo-pericia/laudos sem enviar
