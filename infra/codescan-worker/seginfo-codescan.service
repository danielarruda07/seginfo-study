[Unit]
Description=SegInfo - worker da revisao de codigo (claude-security)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seginfo-codescan
Group=seginfo-codescan
EnvironmentFile=/etc/seginfo-codescan/worker.env
Environment=HOME=/var/lib/seginfo-codescan
Environment=CLAUDE_BIN=/var/lib/seginfo-codescan/.local/bin/claude
Environment=PLUGIN_DIR=/opt/seginfo-codescan/plugin
WorkingDirectory=/var/lib/seginfo-codescan
ExecStart=/usr/bin/python3 -I /opt/seginfo-codescan/worker.py
Restart=on-failure
RestartSec=30
# Limites: a VM 100 tem ~3,4 GB e hospeda a producao (Coolify). Se faltar memoria, morre a
# varredura, nao o app: teto baixo, e CPU/disco com prioridade menor que a dos containers.
MemoryHigh=1000M
MemoryMax=1200M
MemorySwapMax=512M
CPUQuota=150%
CPUWeight=20
IOWeight=20
Nice=10
TasksMax=512
# Endurecimento do processo do worker
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/seginfo-codescan

[Install]
WantedBy=multi-user.target
