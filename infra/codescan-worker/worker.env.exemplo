# /etc/seginfo-codescan/worker.env  (root:seginfo-codescan, 0640) — NUNCA versione o arquivo preenchido.

# API do SegInfo (o worker usa as rotas /api/scan/ci/codigo/*)
SEGINFO_API=https://estudo.criecom.ia.br

# Mesmo valor da variável CODESCAN_WORKER_TOKEN no Coolify (serviço seginfo-api). Gere com: openssl rand -hex 32
CODESCAN_WORKER_TOKEN=

# Service Token do Cloudflare Access que já libera /api/scan/ci (o mesmo do gate de CI: seginfo-ci)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Chave da API da Anthropic de um WORKSPACE DEDICADO a isto, com limite de gasto (exigência do plugin)
ANTHROPIC_API_KEY=

# Opcional: token para clonar repositórios privados por https (GitHub: PAT fine-grained, só leitura de conteúdo)
CODESCAN_GIT_TOKEN=
CODESCAN_GIT_USER=x-access-token

# Opcionais
MAX_HORAS=3
INTERVALO=30
SANDBOX_ARGS=--sudo
