# Copie para .env (NÃO comite .env). No Coolify, use Secrets.

# ---- apps/api ----
# Banco DEDICADO `seginfo_study` dentro do Postgres 16 da VM100, usuário `seginfo_app`
# (ver docs/DEPLOY.md). O host é o NOME DO CONTAINER na rede `coolify`: só resolve
# para containers nessa rede (a API em produção). Do PC de desenvolvimento não é alcançável.
DATABASE_URL=postgresql://seginfo_app:TROCAR_SENHA@lgrzsnhe4pycyjjsoyk7f3hi:5432/seginfo_study?schema=public

# Verificação do JWT do Cloudflare Access (obrigatório em produção; sem isso a API recusa tudo).
# TEAM: nome do time Zero Trust (parte antes de .cloudflareaccess.com).
# AUD: Zero Trust > Access > Applications > estudo > Overview > "Application Audience (AUD) Tag".
CF_ACCESS_TEAM=lampfortup
CF_ACCESS_AUD=TROCAR_AUD_TAG

# Origem do front (CORS). Em produção é o domínio público.
WEB_ORIGIN=https://estudo.criecom.ia.br

# Porta da API (interna).
PORT=3001

# Apenas em DEV, para destravar sem Cloudflare Access na frente:
# DEV_USER_EMAIL=daniel@local
