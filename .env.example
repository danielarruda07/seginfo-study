# Copie para .env (NÃO comite .env). No Coolify, use Secrets.

# ---- apps/api ----
# Banco DEDICADO `seginfo_study` dentro do Postgres 16 da VM100, usuário `seginfo_app`
# (ver docs/DEPLOY.md). O host é o NOME DO CONTAINER na rede `coolify`: só resolve
# para containers nessa rede (a API em produção). Do PC de desenvolvimento não é alcançável.
DATABASE_URL=postgresql://seginfo_app:TROCAR_SENHA@lgrzsnhe4pycyjjsoyk7f3hi:5432/seginfo_study?schema=public

# Verificação do JWT do Cloudflare Access (obrigatório em produção; sem isso a API recusa tudo).
# TEAM: nome do time Zero Trust (parte antes de .cloudflareaccess.com).
# AUD: Zero Trust > Access controls > Applications > estudo > Edit > aba "Additional settings"
#      > "Application Audience (AUD) Tag". Só muda se a aplicação for apagada/recriada.
CF_ACCESS_TEAM=lampfortup

# Radar de Ataques (ingestão por coletores). Gere o token com: openssl rand -hex 32
# INGEST_OWNER_EMAIL = o MESMO e-mail com que você entra no Cloudflare Access (dono dos eventos).
INGEST_TOKEN=TROCAR_TOKEN
INGEST_OWNER_EMAIL=seu-email-do-access@exemplo.com
# Service Token dos coletores: Client ID do token e AUD da aplicação Access `estudo-ingest`.
CF_ACCESS_INGEST_CLIENT_ID=TROCAR.access
CF_ACCESS_INGEST_AUD=TROCAR_AUD_DA_APP_ESTUDO_INGEST
# Senhas tentadas em honeypot: DESLIGADO por padrão. Se ligar, são dado sensível
# (podem ser credenciais reais vazadas de terceiros). Não exiba em print/post/repositório.
RADAR_GUARDAR_SENHAS=false
# Dias de retenção dos eventos (padrão 90).
ATAQUES_RETENCAO_DIAS=90

# ---- Armazenamento externo: OneDrive pessoal + backups cifrados (docs/ARMAZENAMENTO.md) ----
# URL pública da app (sem barra final). Compõe o redirect URI registrado no Microsoft Entra.
PUBLIC_BASE_URL=https://estudo.criecom.ia.br
# Registro do app no Microsoft Entra (contas pessoais).
MS_CLIENT_ID=TROCAR
MS_CLIENT_SECRET=TROCAR
# Chave que cifra o refresh token no banco. Gere com: openssl rand -base64 32
STORAGE_TOKEN_KEY=TROCAR
# Chave PÚBLICA RSA em base64 (a privada NUNCA vai para o servidor). Ver o doc.
BACKUP_PUBLIC_KEY_B64=TROCAR
# Backup diário automático e quantos manter no OneDrive.
BACKUP_AUTOMATICO=false
BACKUP_RETENCAO=14

# ---- IA do módulo LinkedIn (Claude API) ----
# Chave em console.anthropic.com > API Keys. Defina um limite de gasto mensal lá.
# Fica SÓ no servidor (Secret no Coolify); o navegador nunca a vê. Vazia = IA desligada.
ANTHROPIC_API_KEY=

# ---- Agents: ferramentas do Proxmox (docs/AGENTS.md) ----
# Token de API do Proxmox (usuario@realm!nome=segredo). Fica SÓ no servidor.
PROXMOX_URL=
PROXMOX_TOKEN=
# CA do cluster em base64 (base64 -w0 /etc/pve/pve-root-ca.pem). Alternativa só para laboratório: PROXMOX_TLS_INSEGURO=true
PROXMOX_CA_B64=
PROXMOX_TLS_INSEGURO=false

CF_ACCESS_AUD=TROCAR_AUD_TAG

# Origem do front (CORS). Em produção é o domínio público.
WEB_ORIGIN=https://estudo.criecom.ia.br

# Porta da API (interna).
PORT=3001

# Apenas em DEV, para destravar sem Cloudflare Access na frente:
# DEV_USER_EMAIL=daniel@local
